{
  "name": "phylo-lens-client",
  "version": "0.1.0",
  "description": "Headless, scalable phylogenetic tree visualization client. Server-side level-of-detail with a Sigma.js renderer, consumable as a library by host apps such as PHYLOViZ.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build:lib",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,css}\""
  },
  "peerDependencies": {
    "@sigma/node-border": "^3.0.0",
    "@sigma/node-piechart": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-force": "^0.2.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@sigma/node-border": "^3.0.0",
    "@sigma/node-piechart": "^3.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "graphology": "^0.26.0",
    "graphology-layout-force": "^0.2.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.9.5",
    "sigma": "^3.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
