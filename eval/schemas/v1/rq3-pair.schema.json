{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phyloviz.org/phylo-lens/eval/rq3-pair/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pair_id", "warmup", "repetition_index", "source", "camera_state", "execution_order", "conditions", "semantic_equivalence", "representation", "metrics", "invalid_reasons"],
  "properties": {
    "schema_version": {"const": "1"}, "pair_id": {"type": "string", "minLength": 1}, "warmup": {"type": "boolean"}, "repetition_index": {"type": "integer", "minimum": 0},
    "source": {"type": "object", "additionalProperties": false, "required": ["dataset_checksum_sha256", "prepared_layout_id", "viewport", "device_scale_factor", "labels_enabled", "browser_version", "headless", "api_contract_version"], "properties": {"dataset_checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "prepared_layout_id": {"type": "string", "minLength": 1}, "viewport": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}, "device_scale_factor": {"type": "number", "exclusiveMinimum": 0}, "labels_enabled": {"type": "boolean"}, "browser_version": {"type": ["string", "null"]}, "headless": {"type": "boolean"}, "api_contract_version": {"const": "1"}}},
    "camera_state": {"type": "object", "additionalProperties": false, "required": ["id", "request"], "properties": {"id": {"type": "string", "minLength": 1}, "request": {"type": "object"}}},
    "execution_order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"enum": ["full_detail", "triangle_aggregation"]}},
    "conditions": {"type": "object", "additionalProperties": false, "required": ["full_detail", "triangle_aggregation"], "properties": {"full_detail": {"$ref": "#/$defs/condition"}, "triangle_aggregation": {"$ref": "#/$defs/condition"}}},
    "semantic_equivalence": {"type": "object", "additionalProperties": false, "required": ["valid", "triangle_represented_population", "full_detail_represented_population", "reason", "triangle_explicit_node_ids", "triangle_aggregate_member_ids", "full_detail_node_ids"], "properties": {"valid": {"type": "boolean"}, "triangle_represented_population": {"type": "integer", "minimum": 0}, "full_detail_represented_population": {"type": "integer", "minimum": 0}, "reason": {"type": ["string", "null"]}, "triangle_explicit_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "triangle_aggregate_member_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "full_detail_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "representation": {"type": "object", "additionalProperties": false, "required": ["node_difference", "edge_difference", "triangle_difference", "primitive_difference", "primitive_reduction_ratio", "payload_byte_difference", "payload_reduction_ratio"], "properties": {"node_difference": {"type": "integer"}, "edge_difference": {"type": "integer"}, "triangle_difference": {"type": "integer"}, "primitive_difference": {"type": "integer"}, "primitive_reduction_ratio": {"$ref": "#/$defs/metric"}, "payload_byte_difference": {"type": "integer"}, "payload_reduction_ratio": {"$ref": "#/$defs/metric"}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["latency", "heap", "rss", "frame"], "properties": {"latency": {"$ref": "#/$defs/latencyMetrics"}, "heap": {"$ref": "#/$defs/heapMetrics"}, "rss": {"$ref": "#/$defs/rssMetrics"}, "frame": {"$ref": "#/$defs/frameMetrics"}}}, "invalid_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"condition": {"type": "object", "additionalProperties": false, "required": ["observation_path", "fixture", "status"], "properties": {"observation_path": {"type": "string"}, "status": {"type": "string"}, "fixture": {"type": "object", "additionalProperties": false, "required": ["checksum_sha256", "node_count", "edge_count", "triangle_count", "total_primitive_count", "represented_population", "payload_bytes_uncompressed"], "properties": {"checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "node_count": {"type": "integer", "minimum": 0}, "edge_count": {"type": "integer", "minimum": 0}, "triangle_count": {"type": "integer", "minimum": 0}, "total_primitive_count": {"type": "integer", "minimum": 0}, "represented_population": {"type": "integer", "minimum": 0}, "payload_bytes_uncompressed": {"type": "integer", "minimum": 0}}}}}, "metric": {"type": "object", "additionalProperties": false, "required": ["state", "value", "reason"], "properties": {"state": {"enum": ["available", "unavailable"]}, "value": {"type": ["number", "null"]}, "reason": {"type": ["string", "null"]}}}, "latencyMetrics": {"type": "object", "additionalProperties": false, "required": ["absolute_difference_ms", "render_speedup"], "properties": {"absolute_difference_ms": {"$ref": "#/$defs/metric"}, "render_speedup": {"$ref": "#/$defs/metric"}}}, "heapMetrics": {"type": "object", "additionalProperties": false, "required": ["js_heap_used_difference_bytes", "js_heap_used_reduction_ratio"], "properties": {"js_heap_used_difference_bytes": {"$ref": "#/$defs/metric"}, "js_heap_used_reduction_ratio": {"$ref": "#/$defs/metric"}}}, "rssMetrics": {"type": "object", "additionalProperties": false, "required": ["absolute_difference_bytes", "reduction_ratio"], "properties": {"absolute_difference_bytes": {"$ref": "#/$defs/metric"}, "reduction_ratio": {"$ref": "#/$defs/metric"}}}, "frameMetrics": {"type": "object", "additionalProperties": false, "required": ["median_difference_ms", "p95_difference_ms", "maximum_difference_ms", "long_frame_proportion_difference"], "properties": {"median_difference_ms": {"$ref": "#/$defs/metric"}, "p95_difference_ms": {"$ref": "#/$defs/metric"}, "maximum_difference_ms": {"$ref": "#/$defs/metric"}, "long_frame_proportion_difference": {"$ref": "#/$defs/metric"}}}}
}
