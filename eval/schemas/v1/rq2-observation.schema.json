{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phyloviz.org/phylo-lens/eval/rq2-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "observation_id", "warmup", "repetition_index", "status", "failure_kind", "fixture", "browser", "timing", "heap", "rss", "frame_statistics", "artifacts", "replay", "warnings", "error"],
  "properties": {
    "schema_version": {"const": "1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "warmup": {"type": "boolean"},
    "repetition_index": {"type": "integer", "minimum": 0},
    "status": {"enum": ["success", "invalid", "timeout", "failure", "unsupported_metric"]},
    "failure_kind": {"enum": ["none", "invalid_configuration", "fixture_generation_failure", "replay_contract_failure", "browser_launch_failure", "runtime_state_timeout", "bootstrap_failure", "client_load_failure", "render_timeout", "empty_visual_output", "unexpected_network_request", "unexpected_viewport_request", "process_monitor_failure", "browser_crash", "harness_protocol_failure", "insufficient_frame_samples"]},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "generator_version", "random_seed", "checksum_sha256", "node_count", "edge_count", "triangle_count", "total_primitive_count", "bounds", "labels_enabled", "metadata_configuration", "api_contract_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "generator_version": {"type": "string", "minLength": 1}, "random_seed": {"type": "integer"}, "checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "node_count": {"type": "integer", "minimum": 1}, "edge_count": {"type": "integer", "minimum": 0}, "triangle_count": {"type": "integer", "minimum": 0}, "total_primitive_count": {"type": "integer", "minimum": 1},
        "bounds": {"type": "object", "additionalProperties": false, "required": ["min_x", "max_x", "min_y", "max_y"], "properties": {"min_x": {"type": "number"}, "max_x": {"type": "number"}, "min_y": {"type": "number"}, "max_y": {"type": "number"}}},
        "labels_enabled": {"type": "boolean"}, "metadata_configuration": {"type": "string"}, "api_contract_version": {"type": "string", "minLength": 1}
      }
    },
    "browser": {"type": "object", "additionalProperties": false, "required": ["version", "executable_path", "headless", "viewport", "device_scale_factor", "locale", "timezone", "launch_args"], "properties": {"version": {"type": ["string", "null"]}, "executable_path": {"type": ["string", "null"]}, "headless": {"type": "boolean"}, "viewport": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}, "device_scale_factor": {"type": "number", "exclusiveMinimum": 0}, "locale": {"type": "string", "minLength": 1}, "timezone": {"type": "string", "minLength": 1}, "launch_args": {"type": "array", "items": {"type": "string"}}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["load_to_snapshot_applied_ms", "load_to_post_update_frame_ms", "snapshot_applied_to_frame_ms"], "properties": {"load_to_snapshot_applied_ms": {"type": ["number", "null"], "minimum": 0}, "load_to_post_update_frame_ms": {"type": ["number", "null"], "minimum": 0}, "snapshot_applied_to_frame_ms": {"type": ["number", "null"], "minimum": 0}}},
    "heap": {"type": "object", "additionalProperties": false, "required": ["baseline", "post_render", "delta"], "properties": {"baseline": {"$ref": "#/$defs/heapSnapshot"}, "post_render": {"$ref": "#/$defs/heapSnapshot"}, "delta": {"$ref": "#/$defs/heapDelta"}}},
    "rss": {"type": "object", "additionalProperties": false, "required": ["sampling_interval_seconds", "scope", "baseline_rss_bytes", "post_render_rss_bytes", "maximum_rss_bytes", "post_render_delta_bytes", "peak_delta_bytes"], "properties": {"sampling_interval_seconds": {"type": "number", "exclusiveMinimum": 0}, "scope": {"enum": ["process_tree", "root_only"]}, "baseline_rss_bytes": {"type": ["integer", "null"], "minimum": 0}, "post_render_rss_bytes": {"type": ["integer", "null"], "minimum": 0}, "maximum_rss_bytes": {"type": ["integer", "null"], "minimum": 0}, "post_render_delta_bytes": {"type": ["integer", "null"]}, "peak_delta_bytes": {"type": ["integer", "null"]}}},
    "frame_statistics": {"type": "object", "additionalProperties": false, "required": ["sample_count", "median_ms", "p25_ms", "p75_ms", "iqr_ms", "p95_ms", "maximum_ms", "above_frame_budget_count", "above_frame_budget_proportion", "above_33_3_ms_count", "above_33_3_ms_proportion", "above_50_ms_count", "above_50_ms_proportion", "frame_budget_ms", "minimum_sample_count"], "properties": {"sample_count": {"type": "integer", "minimum": 0}, "median_ms": {"type": ["number", "null"], "minimum": 0}, "p25_ms": {"type": ["number", "null"], "minimum": 0}, "p75_ms": {"type": ["number", "null"], "minimum": 0}, "iqr_ms": {"type": ["number", "null"], "minimum": 0}, "p95_ms": {"type": ["number", "null"], "minimum": 0}, "maximum_ms": {"type": ["number", "null"], "minimum": 0}, "above_frame_budget_count": {"type": "integer", "minimum": 0}, "above_frame_budget_proportion": {"type": "number", "minimum": 0, "maximum": 1}, "above_33_3_ms_count": {"type": "integer", "minimum": 0}, "above_33_3_ms_proportion": {"type": "number", "minimum": 0, "maximum": 1}, "above_50_ms_count": {"type": "integer", "minimum": 0}, "above_50_ms_proportion": {"type": "number", "minimum": 0, "maximum": 1}, "frame_budget_ms": {"type": "number", "exclusiveMinimum": 0}, "minimum_sample_count": {"type": "integer", "minimum": 1}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["request", "runtime_state", "phase_ack", "browser_result", "frame_samples", "request_samples", "stdout", "stderr", "replay_access_log", "screenshot"], "properties": {"request": {"type": "string"}, "runtime_state": {"type": "string"}, "phase_ack": {"type": "string"}, "browser_result": {"type": "string"}, "frame_samples": {"type": "string"}, "request_samples": {"type": "string"}, "stdout": {"type": "string"}, "stderr": {"type": "string"}, "replay_access_log": {"type": "string"}, "screenshot": {"type": "string"}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["request_count", "post_initial_viewport_request_count", "input_record"], "properties": {"request_count": {"type": "integer", "minimum": 0}, "post_initial_viewport_request_count": {"type": "integer", "minimum": 0}, "input_record": {"type": ["object", "null"]}}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "error": {"type": ["string", "null"]}
  },
  "$defs": {"metric": {"type": "object", "additionalProperties": false, "required": ["state", "bytes", "reason"], "properties": {"state": {"enum": ["available", "unavailable"]}, "bytes": {"type": ["integer", "null"], "minimum": 0}, "reason": {"type": ["string", "null"]}}}, "deltaMetric": {"type": "object", "additionalProperties": false, "required": ["state", "bytes", "reason"], "properties": {"state": {"enum": ["available", "unavailable"]}, "bytes": {"type": ["integer", "null"]}, "reason": {"type": ["string", "null"]}}}, "heapSnapshot": {"type": "object", "additionalProperties": false, "required": ["js_heap_used_bytes", "js_heap_total_bytes", "embedder_heap_used_bytes", "backing_storage_bytes"], "properties": {"js_heap_used_bytes": {"$ref": "#/$defs/metric"}, "js_heap_total_bytes": {"$ref": "#/$defs/metric"}, "embedder_heap_used_bytes": {"$ref": "#/$defs/metric"}, "backing_storage_bytes": {"$ref": "#/$defs/metric"}}}, "heapDelta": {"type": "object", "additionalProperties": false, "required": ["js_heap_used_bytes", "js_heap_total_bytes", "embedder_heap_used_bytes", "backing_storage_bytes"], "properties": {"js_heap_used_bytes": {"$ref": "#/$defs/deltaMetric"}, "js_heap_total_bytes": {"$ref": "#/$defs/deltaMetric"}, "embedder_heap_used_bytes": {"$ref": "#/$defs/deltaMetric"}, "backing_storage_bytes": {"$ref": "#/$defs/deltaMetric"}}}}
}
