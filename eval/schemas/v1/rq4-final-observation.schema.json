{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phyloviz.org/phylo-lens/eval/rq4-final-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "observation_id",
    "scenario",
    "role",
    "status",
    "failure_kind",
    "provenance",
    "lifecycle",
    "browser",
    "gpu",
    "target",
    "state",
    "timing",
    "baseline_frames",
    "operation_frames",
    "requests",
    "observer",
    "artifacts",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string" },
    "experiment_id": { "const": "rq4-interactive-final-v020" },
    "observation_id": { "type": "string" },
    "scenario": { "type": "string" },
    "role": { "const": "measured" },
    "status": { "enum": ["success", "invalid", "failure", "timeout"] },
    "failure_kind": { "type": "string" },
    "provenance": { "type": "object" },
    "lifecycle": { "type": "object" },
    "browser": { "type": "object" },
    "gpu": { "type": "object" },
    "target": { "type": ["object", "null"] },
    "state": { "type": "object" },
    "timing": { "type": "object" },
    "baseline_frames": { "type": "object" },
    "operation_frames": { "type": "object" },
    "requests": { "type": "object" },
    "observer": { "type": "object" },
    "artifacts": { "type": "object" },
    "error": { "type": ["string", "null"] }
  }
}
