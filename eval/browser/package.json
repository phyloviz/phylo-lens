{
  "name": "phylo-lens-rq2-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "format": "prettier --write \"{src,tests}/**/*.{mjs,ts}\" \"*.{json,html,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{mjs,ts}\" \"*.{json,html,md}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "run": "node src/runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.6.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.5",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.45.0",
    "vite": "5.4.21"
  }
}
