{
  "schema_version": "1",
  "experiments": [
    {
      "id": "rq4-interactive-pilot",
      "research_question": "RQ4",
      "server_state_policy": "fresh_process_public_bootstrap_warm_session",
      "warmup_repetitions": 0,
      "measured_repetitions": 1,
      "timeout_seconds": 60,
      "setup_quiescence_ms": 2000,
      "frame_budget_ms": 16.7,
      "minimum_frame_sample_count": 4,
      "synthetic_dataset": {
        "id": "rq4-pilot-balanced",
        "node_count": 6501,
        "seed": 41
      },
      "browser": {
        "headless": true,
        "viewport": { "width": 960, "height": 640 },
        "device_scale_factor": 1,
        "launch_args": []
      },
      "scenarios": [
        {
          "id": "navigation",
          "operation": "viewport_navigation",
          "input": {
            "kind": "wheel",
            "wheel_delta_y": -1000,
            "wheel_steps": 3,
            "wheel_interval_ms": 70,
            "setup_wheel_steps": 2,
            "setup_wheel_delta_y": 1000,
            "setup_wheel_interval_ms": 70
          }
        },
        {
          "id": "expansion",
          "operation": "cluster_expand",
          "target_cluster_id": null
        },
        {
          "id": "collapse",
          "operation": "cluster_collapse",
          "target_cluster_id": null
        }
      ]
    }
  ]
}
